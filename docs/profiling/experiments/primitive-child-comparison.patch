+// Container leaves are common schema keys. Compare them inline rather than
+// recursively dispatching the complete comparator for every primitive child.
+inline fn compareChild(a: Value, b: Value) std.math.Order {
+    return switch (a) {
+        .null => if (b == .null) .eq else compare(a, b),
+        .bool => if (b == .bool) std.math.order(@intFromBool(a.bool), @intFromBool(b.bool)) else compare(a, b),
+        .number_string => if (b == .number_string) number.compare(a.number_string, b.number_string) catch unreachable else compare(a, b),
+        .string => if (b == .string) std.mem.order(u8, a.string, b.string) else compare(a, b),
+        else => compare(a, b),
+    };
+}
