  {"id":"compiler-call-count","jq":"{commands:length,compiler_calls:([.[]|select(.argv[0]|endswith(\"/z_llvm\"))]|length),last:.[-1].argv}","jqz":"{commands:length(.),compiler_calls:length(filter(.,matches(.argv[0],\"/z_llvm$\"))),last:.[-1]?.argv? ?? null}","file":"examples/zllvm/compiler-call-count.query"},
  {"id":"census-counts","jq":"{examined:([.[]|select(.event==\"function\")]|length),failed:([.[]|select(.event==\"function\" and (.selected|not))]|length)}","jqz":"where((.event? ?? null) == \"function\") | tojson((.selected? ?? null) == null or (.selected? ?? null) == false) | group_by(.) | {failed:.[0] == \"true\",n:length(.)} | collect | {examined:sum(map(.,.n)),failed:sum(map(filter(.,.failed),.n))}","stream":true,"file":"examples/zllvm/census-counts.query"},
  {"id":"census-progress","jq":"{completed:([.[]|select(.event==\"function\")]|length),last:([.[]|select(.event==\"function\")][-1].function)}","jqz":"where((.event? ?? null) == \"function\") | .function? ?? null | collect | {completed:length(.),last:.[-1]? ?? null}","stream":true,"file":"examples/zllvm/census-progress.query"},
  {"id":"provenance-duration","jq":"{file:input_filename,status,returncode,elapsed_seconds:(((.finished_ns // .samples[-1].time_ns // .started_ns)-.started_ns)/1000000000)}","jqz":"{file:input_filename(),status:.status? ?? null,returncode:.returncode? ?? null,elapsed_seconds:divide((.finished_ns? ?? .samples?[-1]?.time_ns? ?? .started_ns)-.started_ns,1000000000,9)}","file":"examples/zllvm/provenance-duration.query","expected_gap":"jqz preserves exact timestamp subtraction and nanosecond-precision decimal seconds; jq 1.7 floating arithmetic loses precision for epoch nanoseconds beyond 2^53. Exact-decimal equality is intentionally required, so this is a reviewed numeric-contract difference."},
  {"id":"grouped-rejections","jq":"[.[]|select(.event==\"function\" and .selected==false)]|group_by(.selector_detail)|map({boundary:.[0].selector_detail,count:length,examples:(map(.function)|.[0:2])})|sort_by(-.count)","jqz":"where((.event? ?? null) == \"function\" and (.selected? ?? null) == false) | {boundary:.selector_detail? ?? null,function:.function? ?? null} | group_by(tojson(.boundary)) | [.[0].boundary,.] | collect | sort_by(map(sort_values(.),{boundary:.[0],count:length(.[1]),examples:map(.[1][0:2],.function)}),0-.count)","stream":true,"file":"examples/zllvm/grouped-rejections.query"},
  {"id":"grouped-selector-pairs","jq":"[.[] | select(.event==\"function\" and .selected==false)] | group_by([.selector_tag,.selector_detail]) | map({tag:.[0].selector_tag,detail:.[0].selector_detail,count:length,functions:map(.function)}) | sort_by(-.count)","jqz":"where((.event? ?? null) == \"function\" and (.selected? ?? null) == false) | {tag:.selector_tag? ?? null,detail:.selector_detail? ?? null,function:.function? ?? null} | group_by(tojson([.tag,.detail])) | [.[0].tag,.[0].detail,.] | collect | sort_by(map(sort_values(.),{tag:.[0],detail:.[1],count:length(.[2]),functions:map(.[2],.function)}),0-.count)","stream":true,"file":"examples/zllvm/grouped-selector-pairs.query"},
  {"id":"nul-path-protocol","jq":".files|keys[]|.,\"\\u0000\"","jqz":"map(keys(.files),[.,\"\\u0000\"]) | each | each","expected_gap":"jq -jr emits NUL-delimited bytes with no newlines. jqz has raw output but no join-output/-j option; its mandatory newlines change this protocol."}
